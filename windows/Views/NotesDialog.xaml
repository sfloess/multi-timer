<Window x:Class="MultiTimer.Views.NotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer Notes" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Timer Notes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="White"/>

        <TextBox x:Name="NotesTextBox" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Padding="8"
                 Margin="0,0,0,15"
                 Background="{DynamicResource CardBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="#3B82F6"
                 BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" 
                    Width="85" 
                    Height="32" 
                    Margin="0,0,10,0" 
                    IsDefault="True" 
                    Click="SaveButton_Click"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Cancel" 
                    Width="85" 
                    Height="32" 
                    IsCancel="True" 
                    Click="CancelButton_Click"
                    Background="{DynamicResource CardBrush}"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
