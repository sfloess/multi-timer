<UserControl x:Class="MultiTimer.Views.TimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MultiTimer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:Type vm:TimerViewModel}"
             Background="{DynamicResource CardBackgroundBrush}"
             BorderBrush="{DynamicResource BorderBrush}"
             BorderThickness="1"
             CornerRadius="8"
             Margin="0,0,0,10">
    
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header (Name & Select CheckBox) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <CheckBox DockPanel.Dock="Left" 
                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,8,0"/>
                
                <Button DockPanel.Dock="Right" 
                        Content="🗑" 
                        Command="{Binding DeleteCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip="Delete Timer"
                        Width="24" Height="24"/>

                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" 
                         FontWeight="SemiBold" 
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"/>
            </DockPanel>

            <!-- Row 1: Digital Clock Display & Duration Pickers -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Time Display -->
                <TextBlock Grid.Column="0" 
                           Text="{Binding DisplayTime}" 
                           FontSize="32" 
                           FontFamily="Consolas" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Time Picker (Hours, Minutes, Seconds) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="2,0">
                        <TextBlock Text="H" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding SetHours, UpdateSourceTrigger=LostFocus}" Width="35" TextAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="2,5,2,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="M" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding SetMinutes, UpdateSourceTrigger=LostFocus}" Width="35" TextAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="2,5,2,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="S" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding SetSeconds, UpdateSourceTrigger=LostFocus}" Width="35" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Row 2: Control Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{Binding IsRunning, Converter={StaticResource BoolToStartStopConverter}}" 
                        Command="{Binding ToggleStartCommand}" 
                        Width="70" 
                        Margin="0,0,5,0"
                        Padding="5,4"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        BorderBrush="Transparent"/>
                
                <Button Content="Reset" 
                        Command="{Binding ResetCommand}" 
                        Width="60" 
                        Margin="0,0,5,0"
                        Padding="5,4"/>
            </StackPanel>

            <!-- Row 3: Notes -->
            <StackPanel Grid.Row="3">
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" 
                         AcceptsReturn="True" 
                         Height="40" 
                         TextWrapping="Wrap"
                         FontSize="12"
                         ToolTip="Notes"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
