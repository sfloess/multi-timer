<Window x:Class="MultiTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiTimer.ViewModels"
        Title="Multi-Timer" Height="600" Width="450"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextBrush" Color="White"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add Timer" Command="{Binding AddTimerCommand}" Margin="0,0,5,0" Padding="10,5"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="Move Up" Command="{Binding MoveUpCommand}" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="Move Down" Command="{Binding MoveDownCommand}" Margin="0,0,5,0" Padding="10,5"/>
            <Button Content="Clear All" Command="{Binding ClearAllCommand}" Padding="10,5"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Timers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="White"
                                             FontWeight="Bold" FontSize="14"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="{Binding DisplayTime}"
                                           FontSize="32" FontFamily="Consolas" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,5"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="Start" Command="{Binding StartCommand}" Width="70" Margin="0,0,5,0"
                                            Padding="5,4" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
                                    <Button Content="Pause" Command="{Binding PauseCommand}" Width="70" Margin="0,0,5,0" Padding="5,4"/>
                                    <Button Content="Reset" Command="{Binding ResetCommand}" Width="70" Padding="5,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
